{
  "manifest_version": 3,
  "name": "UChicago Login Assistant",
  "description": "Make your UChicago account sign-in simpler and faster.",
  "version": "1.6.15",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "cookies"
  ],
  "host_permissions": [
    "*://uchicago.okta.com/*",
    "*://*.duosecurity.com/*",
    "https://portal.uchicago.edu/*",
    "https://courses.uchicago.edu/*",
    "*://*.ais.uchicago.edu/*",
    "*://my.uchicago.edu/"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UChicago Login Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "settings.html",
  "content_scripts": [
    {
      "matches": [
        "https://uchicago.okta.com/*"
      ],
      "js": [
        "content/routes.js",
        "content/dom.js",
        "content/okta.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://portal.uchicago.edu/ais",
        "https://portal.uchicago.edu/ais/*",
        "https://courses.uchicago.edu/*",
        "https://my.uchicago.edu/*"
      ],
      "js": [
        "content/routes.js",
        "content/dom.js",
        "content/entry.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.duosecurity.com/*"
      ],
      "js": [
        "content/dom.js",
        "content/duo.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.duosecurity.com/*"
      ],
      "js": [
        "content/passkey-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "incognito": "split",
  "web_accessible_resources": [
    {
      "resources": [
        "start.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
